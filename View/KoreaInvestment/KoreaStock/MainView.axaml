<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:v="using:trading_platform.View"
  xmlns:vkis="using:trading_platform.View.KoreaInvestment.KoreaStock"
  xmlns:vmkis="using:trading_platform.ViewModel.KoreaInvestment.KoreaStock"
  xmlns:com="using:trading_platform.Components"
  xmlns:comkis="using:trading_platform.Components.KoreaInvestment"
  mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
  x:Class="trading_platform.View.KoreaInvestment.KoreaStock.MainView"
  x:DataType="vmkis:KoreaStockMarket"
  x:Name="ControlRoot"
>
  <TabControl>
    <TabItem Header="차트/주문" >
      <vkis:ChartView
        Name="PART_StockChartAndOrder" 
        DataContext="{Binding MainItem}"
        OrderDataContext="{Binding #ControlRoot.DataContext.Order}"
      />
    </TabItem>
    <!-- <TabItem Header="빠른 주문">
      <vkis:KoreaStockQuickOrder
        DataContext="{Binding #ControlRoot.DataContext"
      />
    </TabItem> -->
    <TabItem Header="재무정보" >
      <vkis:FinancialView 
        Name="PART_FinancialInfo"
        DataContext="{Binding ((vmkis:MarketItem)MainItem).FinancialInformation}"
      />
    </TabItem>
    <TabItem Header="잔고">
      <vkis:BalanceView
        DataContext="{Binding Balance}"
      />
    </TabItem>
  </TabControl>
</UserControl>
