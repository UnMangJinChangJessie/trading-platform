<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:com="using:trading_platform.Components"
  xmlns:comkis="using:trading_platform.Components.KoreaInvestment"
  xmlns:mkis="using:trading_platform.Model.KoreaInvestment"
  xmlns:vmkis="using:trading_platform.ViewModel.KoreaInvestment.KoreaStock"
  x:Class="trading_platform.View.KoreaInvestment.KoreaStock.BalanceView"
  x:DataType="vmkis:Balance"
  x:Name="ControlRoot"
>
<DockPanel Margin="5">
  <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" DockPanel.Dock="Top" >
    <comkis:Account
      DataContext="{Binding Account}"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
    />
    <Button Click="AccountButton_Click">조회</Button>
  </StackPanel>
  <com:ProfitLossList
    DataContext="{Binding #ControlRoot.DataContext}"
  />
</DockPanel>
</UserControl>